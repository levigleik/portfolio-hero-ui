# Server-only credentials: never prefix with NEXT_PUBLIC_.
# Resend > API Keys > create a Sending access key restricted to your verified domain.
RESEND_API_KEY=
# Arcjet > create a project/site > copy the key issued by its dashboard.
ARCJET_KEY=

# Verify envio.gleiksoft.dev in Resend before using this sender.
CONTACT_FROM_EMAIL="Portfólio Levi Gleik <formulario@envio.gleiksoft.dev>"
# Existing forwarding sends this address to levigleik@gmail.com.
CONTACT_TO_EMAIL=contato@gleiksoft.dev
# Set to the public portfolio origin in production. Leave blank for local development.
CONTACT_SITE_URL=
